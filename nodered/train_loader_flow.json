    {
        "id": "function_next_line",
        "type": "function",
        "z": "077405683a14fdcf",
        "name": "Select next line",
        "func": "// Get lines array\nvar lines = context.get('lines');\n\n// If lines have NOT been initialised yet, initialise them here\nif (!lines) {\n    lines = [\n        'bakerloo','central','circle','district',\n        'hammersmith-city','jubilee','metropolitan',\n        'northern','piccadilly','victoria','waterloo-city'\n    ];\n    context.set('lines', lines);\n}\n\n// Get current index\nvar index = context.get('index') || 0;\n\n// Select line\nvar line_id = lines[index];\nmsg.line_id = line_id;\n\n// Increment index\nindex = (index + 1) % lines.length;\ncontext.set('index', index);\n\n// Build URL\nmsg.url = 'https://api.tfl.gov.uk/Line/' + line_id + '/Arrivals';\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
